{
  "name": "audio-augment",
  "version": "1.0.0",
  "description": "A fast, simple, and precise audio editing studio built for creators and artists. Clean and edit your tracks effortlessly right at your fingertips.",
  "author": "Creators AI Lab",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --config web/vite.config.ts --open /editor/",
    "build": "npm run web:build",
    "desktop:build": "vite build --config electron/vite.config.ts",
    "desktop": "npm run desktop:build && electron electron/main.cjs",
    "desktop:package": "npm run desktop:build && electron-builder --win",
    "web:build": "vite build --config web/vite.config.ts && node -e \"const fs=require('fs');fs.copyFileSync('web-dist/docs/index.html','web-dist/index.html');fs.rmSync('web-dist/docs',{recursive:true,force:true});\"",
    "preview": "vite preview --config web/vite.config.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "build": {
    "appId": "com.creatorsailab.audioaugment",
    "productName": "Audio Augment Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "desktop-dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/android-chrome-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Audio Augment",
      "artifactName": "audio-augment-${version}.${ext}"
    }
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "lamejs": "^1.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.1.5"
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
